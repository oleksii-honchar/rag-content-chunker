# mcp-proxy → Mnemosyne stdio bridge
#
# Uses mcp-proxy to expose Mnemosyne (stdio MCP server) via HTTP.
# No client code changes required — same MCP JSON-RPC protocol.
#
# Build:
#   docker build -f Dockerfile.mnemosyne-proxy -t rag-mnemosyne-proxy .
#
# Run:
#   docker run -d --rm -p 3000:3000 -v mnemosyne-data:/data rag-mnemosyne-proxy

FROM ghcr.io/sparfenyuk/mcp-proxy:0.12.0

# Install Python for Mnemosyne (Alpine packages)
RUN apk add --no-cache \
    python3 py3-pip py3-wheel \
    git curl \
    && rm -rf /var/cache/apk/*

# Install Mnemosyne from source
ARG MNEMOSYNE_REPO_URL=https://github.com/mnemosyne-oss/mnemosyne.git
ARG MNEMOSYNE_COMMIT=33540d2213c83fb2d5a0e004aef1fce78e5dbd76

RUN git clone --depth 1 ${MNEMOSYNE_REPO_URL} /tmp/mnemosyne && \
    cd /tmp/mnemosyne && \
    git fetch --depth 1 origin ${MNEMOSYNE_COMMIT} && \
    git checkout ${MNEMOSYNE_COMMIT} && \
    pip install --no-cache-dir "mcp>=1.0.0,<2.0.0" && \
    pip install --no-cache-dir ".[mcp]" && \
    rm -rf /tmp/mnemosyne

# Data directory
WORKDIR /data
ENV MNEMOSYNE_DATA_DIR=/data
VOLUME /data

# Default port
ENV PROXY_PORT=3000
ENV PROXY_HOST=0.0.0.0

# Authentication handled by LiteLLM (no token needed)

# Health check — probe proxy HTTP endpoint
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=6 \
    CMD curl -sf http://localhost:3000/sse -o /dev/null || exit 1

# Expose port
EXPOSE ${PROXY_PORT}

# Run mcp-proxy in server mode
# Listens on HTTP port, spawns mnemosyne mcp as subprocess
ENTRYPOINT ["mcp-proxy", "--port", "3000", "--host", "0.0.0.0", "--"]
CMD ["mnemosyne", "mcp"]
