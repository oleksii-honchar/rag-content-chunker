{
  "name": "rag-content-chunker",
  "version": "1.0.0",
  "description": "DDD-based NestJS CLI server for semantic content chunking before Mnemosyne MCP ingestion",
  "bin": {
    "rag-content-chunker": "dist/main.js"
  },
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "@mastra/rag": "2.4.2",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/event-emitter": "^3.1.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-node": "0.221.0",
    "chokidar": "5.0.0",
    "config": "4.4.2",
    "dotenv": "17.4.2",
    "js-yaml": "5.2.2",
    "nestjs-pino": "4.6.1",
    "pino": "10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.28",
    "@types/jest": "30.0.0",
    "@types/js-yaml": "latest",
    "@types/node": "^22.15.0",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "10.8.0",
    "jest": "^29.7.0",
    "pino-pretty": "13.1.3",
    "source-map-support": "0.5.21",
    "ts-jest": "^29.4.12",
    "ts-node": "10.9.2",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "protobufjs@7.6.5": true,
    "unrs-resolver@1.12.2": true
  }
}
